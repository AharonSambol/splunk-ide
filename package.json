{
  "name": "splunk-ide",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron-forge start",
    "start:user-a": "electron-forge start -- --user-data-dir=/tmp/splunk-ide-user-a",
    "start:user-b": "electron-forge start -- --user-data-dir=/tmp/splunk-ide-user-b",
    "test": "npm run test:unit",
    "test:unit": "node --test $(find test -name '*.test.js' | sort)",
    "test:smoke": "playwright test",
    "test:ui": "npm run test:unit && npm run test:smoke",
    "test:syntax": "for f in main.js renderer.js renderer/*.js renderer/*/*.js webview-preload.js injectors/*.js lib/*.js lib/*/*.js; do node --check \"$f\" || exit 1; done",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "keywords": [],
  "author": "Aharon Sambol",
  "license": "ISC",
  "description": "An IDE for writing Splunk queries",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.61.1",
    "electron": "^41.7.1",
    "jsdom": "^29.1.1"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "simple-git": "^3.36.0"
  }
}
